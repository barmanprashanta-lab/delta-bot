# ─── Anthropic (the bot's brain) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6

# ─── Delta Exchange API ───────────────────────────────────────────────────────
DELTA_API_KEY=your_delta_key
DELTA_API_SECRET=your_delta_secret
DELTA_API_URL=https://api.india.delta.exchange
DELTA_WS_URL=wss://socket.india.delta.exchange

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/delta_scalper

# ─── Bot tuning ───────────────────────────────────────────────────────────────
BOT_SYMBOL=BTCUSD
BOT_PRODUCT_ID=27
BOT_MAX_LEVERAGE=5
BOT_MAX_POSITION_USD=5000
BOT_SCAN_INTERVAL_MS=15000
BOT_PRICE_MONITOR_MS=1000
BOT_MIN_CONFIDENCE=65
BOT_MAX_DRAWDOWN_PCT=0.1

# CRITICAL: leave unset or PAPER until you have validated on paper. LIVE risks real funds.
BOT_MODE=PAPER
